# 板载 N16R16：16MB flash + 16MB PSRAM（官方 ESP32-S31-Korvo-1 V1.1）
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# ★ 二进制帧走 stdout：关掉 libc 的 LF→CRLF 转换，否则 0x0A 字节会被扩成
#   0D 0A，7 字节帧长度与校验全错（帧协议/波形直接解不出来）。
CONFIG_LIBC_STDOUT_LINE_ENDING_LF=y
# 联网演示凭据只留在本地 sdkconfig（已被 .gitignore 忽略）；这里给空默认值，
# 不配置时固件只跑串口链路。
CONFIG_WAVE_WIFI_SSID=""
CONFIG_WAVE_WIFI_PASSWORD=""
CONFIG_WAVE_TCP_PORT=9000
CONFIG_WAVE_UDP_PORT=9100
CONFIG_WAVE_UDP_HOST=""
