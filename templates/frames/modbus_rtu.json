{
  "id": "modbus_rtu",
  "label": "Modbus RTU 响应（多 ID）",
  "desc": "按功能码分发：0x03 读保持寄存器 / 0x10 写多个寄存器；CRC16 尾校验。0x03 用字节计数反算帧长。",
  "frame": {
    "max_bytes": 256,
    "length_field": {
      "offset": 2,
      "type": "u8",
      "mul": 1,
      "add": 5
    },
    "id_field": {
      "offset": 1,
      "type": "u8"
    }
  },
  "checksum": {
    "kind": "crc16modbus",
    "at": "tail"
  },
  "variants": [
    {
      "id": "0x03",
      "label": "读保持寄存器",
      "fields": [
        {
          "name": "byte_count",
          "offset": 2,
          "type": "u8",
          "plot": false
        },
        {
          "name": "reg0",
          "offset": 3,
          "type": "u16",
          "endian": "be"
        }
      ]
    },
    {
      "id": "0x10",
      "label": "写多个寄存器",
      "fields": [
        {
          "name": "start_addr",
          "offset": 2,
          "type": "u16",
          "endian": "be",
          "plot": false
        },
        {
          "name": "quantity",
          "offset": 4,
          "type": "u16",
          "endian": "be"
        }
      ]
    }
  ]
}
