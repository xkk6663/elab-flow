{
  "name": "dsh-elab-cockpit",
  "version": "0.2.0",
  "description": "elab-Flow 闭环驾驶舱的 DSH 插件：右栏窄栏面板（阶梯 + 日志尾），发现/接入/构建/烧录/调试/串口闭环一体化",
  "type": "module",
  "main": "lib/main.js",
  "exports": {
    ".": {
      "default": "./lib/main.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\"",
    "build:host": "tsc -p tsconfig.host.json --outDir lib",
    "build:client": "node scripts/build-client.mjs",
    "verify:contract": "node scripts/verify-client-contract.mjs",
    "build": "npm run build:host && npm run build:client && npm run verify:contract"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ]
}
