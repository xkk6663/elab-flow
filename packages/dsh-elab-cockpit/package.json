{
  "name": "dsh-elab-cockpit",
  "version": "0.5.0",
  "description": "嵌入式闭环开发的 DSH 驾驶舱：agent 在面板里闭环开发 STM32（发现/编译/烧录/调试/串口），开发过程对用户全程可视化——阶梯进度、实时日志、RAM/FLASH 占用、串口波形",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "elab",
    "embedded",
    "firmware",
    "flash",
    "openocd",
    "serial",
    "ota"
  ],
  "type": "module",
  "main": "lib/main.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/main.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ./test/core-hooks.mjs --test \"test/*.test.mjs\"",
    "build:host": "tsc -p tsconfig.host.json --outDir lib",
    "build:client": "node scripts/build-client.mjs",
    "verify:contract": "node scripts/verify-client-contract.mjs",
    "build": "npm run build:host && npm run build:client && npm run verify:contract"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.30",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "adm-zip": "^0.5.16",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkk6663/elab-flow.git",
    "directory": "packages/dsh-elab-cockpit"
  },
  "files": [
    "lib",
    "envpacks/manifest.json",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "screenshots.json",
    "assets"
  ]
}
