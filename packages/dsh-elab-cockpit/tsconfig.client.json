{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    // 只做类型检查（CI: tsc --noEmit）；不设 rootDir —— 会 import 包外的共享层源码
    "baseUrl": ".",
    "paths": {
      "@elab/cockpit-ui-core": ["../cockpit-ui-core/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react",
    "declaration": false,
    "sourceMap": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": []
  },
  "include": [
    "src/adapters/dsh-web/**/*.ts",
    "src/adapters/dsh-web/**/*.tsx"
  ]
}
