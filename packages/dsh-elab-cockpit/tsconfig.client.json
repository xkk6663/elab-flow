{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "outDir": "build/client",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react",
    "declaration": false,
    "sourceMap": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": []
  },
  "include": [
    "src/adapters/dsh-web/**/*.ts",
    "src/adapters/dsh-web/**/*.tsx"
  ]
}
