{
  "name": "dsh-elab-iframe",
  "version": "0.1.0",
  "description": "elab-Flow 闭环驾驶舱的 iframe 探针：右栏内嵌独立驾驶舱窗口，用于实测可用宽度与交互手感（P0）",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "icon": "./icon.svg"
}
