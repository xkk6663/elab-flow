# elab-Flow 工作目录（构建产物 / 生成物），不入库
.work/

# 「⋯ → 移除工程」留下的恢复备份（只删接入文件，业务工程不动）
projects/*.yaml.bak

# 示例工程内的历史 IDE / CMake 构建产物
# （elab 自身产物落在 .work/；examples/ 的源码照常入库，CI 依赖它）
build/
# ESP-IDF 每台机器按默认值生成的本地配置；入库的只有 sdkconfig.defaults
examples/**/sdkconfig
examples/**/sdkconfig.old

# 适配包安装目录（按需从市场/官方源安装，不入库）；
# 随仓只保留 packs/official/**（官方包源）与 market/index.json（索引）
packs/installed/

# 工具链 provider 安装目录（按需从市场/官方源安装，不入库）；
# 随仓只保留 providers/official/**（官方源）与 market/index.json（索引）
providers/installed/

# 芯片平台 skill 由 `elab pkg install` / `elab skill` 从适配包生成（骨架不含芯片）。
# 入库的只有通用 elab-loop skill。
skills/*/*/SKILL.md
.agents/skills/*/SKILL.md
!.agents/skills/elab-loop/SKILL.md
!.agents/skills/elab-release/SKILL.md

# Python 字节码
__pycache__/
*.pyc


# 浏览器验证截图（临时产物，不入库）
.screenshots/

# WorkBuddy 会话数据（不入库）
.workbuddy/

# 插件的第三方依赖（@deepseek-ai/dsh-tools 等），入库的只有 lib/ 产物
node_modules/

